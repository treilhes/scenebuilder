	<force-as-classpath groupId="org.slf4j" artifactId="jul-to-slf4j"/>
	<force-as-classpath groupId="org.springframework.boot" artifactId="spring-boot-starter-data-jpa"/>
	<force-as-classpath groupId="org.springframework.boot" artifactId="spring-boot-starter-jdbc"/>
	<force-as-classpath groupId="com.zaxxer" artifactId="HikariCP"/>
	<force-as-classpath groupId="org.springframework" artifactId="spring-jdbc"/>
	<force-as-classpath groupId="jakarta.transaction" artifactId="jakarta.transaction-api"/>
	<force-as-classpath groupId="org.jboss.logging" artifactId="jboss-logging"/>
	<force-as-classpath groupId="org.hibernate.common" artifactId="hibernate-commons-annotations"/>
