<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootVbox" maxHeight="Infinity" maxWidth="Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" styleClass="store-vbox" stylesheets="@AppDetail.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0" styleClass="store-title-hbox" VBox.vgrow="NEVER">
         <children>
            <Label styleClass="store-title-label" text="Search" />
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" styleClass="store-search-hbox" VBox.vgrow="NEVER">
         <children>
            <TextField styleClass="store-search-textfield" />
            <Button mnemonicParsing="false" styleClass="store-search-button" text="Button" />
         </children>
      </HBox>
      <VBox styleClass="store-searchresults-vbox" VBox.vgrow="ALWAYS">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" styleClass="store-searchresults-title-hbox">
               <children>
                  <Label styleClass="store-searchresults-title-label" text="Applications" />
               </children>
            </HBox>
            <ListView fx:id="applications" prefHeight="200.0" prefWidth="200.0" styleClass="store-searchresults-listview" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </children>
</VBox>
