<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.treilhes.scenebuilder</groupId>
    <artifactId>scenebuilder.fxom.metadata</artifactId>
    <version>${scenebuilder.version}</version>
  </parent>
  <artifactId>scenebuilder.metadata.javafx</artifactId>
  <packaging>pom</packaging>
  
  <modules>
    <module>scenebuilder.metadata.javafx.customization</module>
    <module>scenebuilder.metadata.javafx.data</module>
    <module>scenebuilder.metadata.javafx.11</module>
    <module>scenebuilder.metadata.javafx.15</module>
    <module>scenebuilder.metadata.javafx.22</module>
    <module>scenebuilder.metadata.javafx.26</module>
  </modules>
  
  <dependencies>
      <dependency>
            <groupId>com.treilhes.jfxplace</groupId>
            <artifactId>jfxplace.core.api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.treilhes.jfxplace</groupId>
            <artifactId>jfxplace.fxom.api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.treilhes.scenebuilder</groupId>
            <artifactId>scenebuilder.api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.treilhes.scenebuilder</groupId>
            <artifactId>scenebuilder.fxom.metadata.base</artifactId>
            <version>${scenebuilder.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.treilhes.jfxplace</groupId>
            <artifactId>jfxplace.core.starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.treilhes.jfxplace</groupId>
                    <artifactId>jfxplace.javafx.starter</artifactId>
                </exclusion>
            </exclusions>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.treilhes.scenebuilder</groupId>
            <artifactId>scenebuilder.metadata.javafx.fx</artifactId>
            <scope>provided</scope>
        </dependency>
  </dependencies>
  <build>
        
    
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.treilhes.jfxplace</groupId>
                    <artifactId>jfxplace-fxom-metadata-maven-plugin</artifactId>
                    <version>${jfxplace.version}</version>
                    <configuration>
                        <outputResourceFolder>${basedir}/src/main/resources</outputResourceFolder>
                        <jarFilterPatterns>
                            <jarFilterPatterns>.*[/\\](javafx-(.*?))[/\\].*</jarFilterPatterns>
                        </jarFilterPatterns>
                        <rootClasses>
                            <rootClass>javafx.scene.Node</rootClass>
                            <rootClass>javafx.scene.Scene</rootClass>
                            <rootClass>javafx.scene.control.MenuItem</rootClass>
                            <rootClass>javafx.scene.control.Tab</rootClass>
                            <rootClass>javafx.scene.control.TableColumnBase</rootClass>
                            <rootClass>javafx.scene.control.TextFormatter</rootClass>
                            <rootClass>javafx.scene.layout.RowConstraints</rootClass>
                            <rootClass>javafx.scene.layout.ColumnConstraints</rootClass>
                            <rootClass>javafx.scene.shape.PathElement</rootClass>
                            <rootClass>javafx.stage.Window</rootClass>
                        </rootClasses>
                        <excludeClasses>
                            <excludeClass>javafx.scene.control.Cell</excludeClass>
                        </excludeClasses>
                        <includePackages>
                            <includePackage>javafx</includePackage>
                        </includePackages>
                        <excludePackages>
                            <excludePackage>javafx.scene.control.skin</excludePackage>
                        </excludePackages>
                        <constructorOverrides>
                            <constructorOverride>
                                <cls>javafx.scene.chart.BubbleChart</cls>
                                <parameterOverrides>
                                    <parameterOverride>
                                        <cls>javafx.scene.chart.Axis</cls>
                                        <overridedBy>javafx.scene.chart.NumberAxis</overridedBy>
                                    </parameterOverride>
                                    <parameterOverride>
                                        <cls>javafx.scene.chart.Axis</cls>
                                        <overridedBy>javafx.scene.chart.NumberAxis</overridedBy>
                                    </parameterOverride>
                                </parameterOverrides>
                            </constructorOverride>
                            <constructorOverride>
                                <cls>javafx.scene.chart.StackedBarChart</cls>
                                <parameterOverrides>
                                    <parameterOverride>
                                        <cls>javafx.scene.chart.Axis</cls>
                                        <overridedBy>javafx.scene.chart.CategoryAxis</overridedBy>
                                    </parameterOverride>
                                    <parameterOverride>
                                        <cls>javafx.scene.chart.Axis</cls>
                                        <overridedBy>javafx.scene.chart.NumberAxis</overridedBy>
                                    </parameterOverride>
                                </parameterOverrides>
                            </constructorOverride>
                            <constructorOverride>
                                <cls>javafx.scene.chart.StackedAreaChart</cls>
                                <parameterOverrides>
                                    <parameterOverride>
                                        <cls>javafx.scene.chart.Axis</cls>
                                        <overridedBy>javafx.scene.chart.Axis</overridedBy>
                                    </parameterOverride>
                                    <parameterOverride>
                                        <cls>javafx.scene.chart.Axis</cls>
                                        <overridedBy>javafx.scene.chart.ValueAxis</overridedBy>
                                    </parameterOverride>
                                </parameterOverrides>
                            </constructorOverride>
                            <constructorOverride>
                                <cls>javafx.scene.chart.BarChart</cls>
                                <parameterOverrides>
                                    <parameterOverride>
                                        <cls>javafx.scene.chart.Axis</cls>
                                        <overridedBy>javafx.scene.chart.CategoryAxis</overridedBy>
                                    </parameterOverride>
                                    <parameterOverride>
                                        <cls>javafx.scene.chart.Axis</cls>
                                        <overridedBy>javafx.scene.chart.NumberAxis</overridedBy>
                                    </parameterOverride>
                                </parameterOverrides>
                            </constructorOverride>
                        </constructorOverrides>
                        <targetPackage>com.oracle.javafx.scenebuilder.metadata.javafx</targetPackage>
                        <extensionName>JavafxMetadataExtension</extensionName>
                        <moduleName>scenebuilder.metadata.javafx</moduleName>
                        <parentUuid>06ae1f67-a8aa-49e3-abb5-4f108534578c</parentUuid>
                        <uuid>5cadadb4-8aba-44f1-b66d-78e988cd998c</uuid>
                        <failOnError>false</failOnError>
                        <javafxVersion>${javafx.version}</javafxVersion>
                        
                        <moduleRequires>
                            <moduleRequire>scenebuilder.fxom.metadata.base</moduleRequire>
                            <moduleRequire>javafx.swing</moduleRequire>
                            <moduleRequire>javafx.media</moduleRequire>
                            <moduleRequire>javafx.controls</moduleRequire>
                            <moduleRequire>javafx.fxml</moduleRequire>
                            <moduleRequire>javafx.web</moduleRequire>
                        </moduleRequires>
                        <componentCustomizationClass>com.oracle.javafx.scenebuilder.metadata.custo.ComponentCusto</componentCustomizationClass>
                        <componentPropertyCustomizationClass>com.oracle.javafx.scenebuilder.metadata.custo.ComponentPropertyCusto</componentPropertyCustomizationClass>
                        <valuePropertyCustomizationClass>com.oracle.javafx.scenebuilder.metadata.custo.ValuePropertyCusto</valuePropertyCustomizationClass>
                        
                        <templateForComponentCustomization>/_templates/CustomizeComponent.ftl</templateForComponentCustomization>
                        <templateForComponentConstructorCustomization>/_templates/CustomizeComponentConstructor.ftl</templateForComponentConstructorCustomization>
                        <templateForComponentPropertyCustomization>/_templates/CustomizeComponentProperty.ftl</templateForComponentPropertyCustomization>
                        <templateForValuePropertyCustomization>/_templates/CustomizeValueProperty.ftl</templateForValuePropertyCustomization>
                        <templateForStaticValuePropertyCustomization>/_templates/CustomizeStaticValueProperty.ftl</templateForStaticValuePropertyCustomization>
                        
                        <targetComponentSuperClass>com.oracle.javafx.scenebuilder.metadata.custom.SbComponentClassMetadata</targetComponentSuperClass>
                        <targetComponentCustomizationClass>com.oracle.javafx.scenebuilder.metadata.custom.ComponentClassMetadataCustomization</targetComponentCustomizationClass>
                        <targetComponentPropertyCustomizationClass>com.oracle.javafx.scenebuilder.metadata.custom.ComponentPropertyMetadataCustomization</targetComponentPropertyCustomizationClass>
                        <targetValuePropertyCustomizationClass>com.oracle.javafx.scenebuilder.metadata.custom.ValuePropertyMetadataCustomization</targetValuePropertyCustomizationClass>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.treilhes.scenebuilder</groupId>
                            <artifactId>scenebuilder.api</artifactId>
                            <version>${scenebuilder.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>com.treilhes.scenebuilder</groupId>
                            <!--<artifactId>scenebuilder.metadata.customization</artifactId>-->
                            <artifactId>scenebuilder.fxom.metadata.base</artifactId>
                            <version>${scenebuilder.version}</version>
                            <exclusions>
                                <exclusion>
                                    <groupId>com.treilhes.scenebuilder</groupId>
                                    <artifactId>scenebuilder.starter</artifactId>
                                </exclusion>
                            </exclusions>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>