<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.treilhes.scenebuilder</groupId>
        <artifactId>scenebuilder.driver.javafx</artifactId>
        <version>${scenebuilder.version}</version>
    </parent>
    <artifactId>scenebuilder.driver.javafx.22</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.treilhes.scenebuilder</groupId>
            <artifactId>scenebuilder.fxom.metadata.base</artifactId>
            <version>${scenebuilder.version}</version>
        </dependency>
        <dependency>
            <groupId>com.treilhes.scenebuilder</groupId>
            <artifactId>scenebuilder.api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.treilhes.scenebuilder</groupId>
            <artifactId>scenebuilder.starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.treilhes.scenebuilder</groupId>
            <artifactId>scenebuilder.metadata.javafx.22</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.treilhes.scenebuilder</groupId>
            <artifactId>scenebuilder.starter.test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.treilhes.jfxplace</groupId>
                <artifactId>jfxplace-source-override-maven-plugin</artifactId>
                <version>${jfxplace.version}</version>
                <executions>
                    <execution>
                        <id>override-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>override</goal>
                        </goals>
                        <configuration>
                            <sourceDependency>
                                <groupId>com.treilhes.scenebuilder</groupId>
                                <artifactId>scenebuilder.driver.javafx.15</artifactId>
                                <version>${scenebuilder.version}</version>
                            </sourceDependency>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>